# Backend de SMI. En esta máquina :3000, :3001 y :3002 son de otros proyectos:
# SMI corre en :3003 (`PORT=3003` en el backend).
VITE_API_URL=http://localhost:3003

# Solo para la prueba en tablet detrás de un túnel HTTPS — ver
# docs/tunel-tablet.md. No hace falta para el dev normal (`npm run dev`).
# VITE_PREVIEW_PROXY=true
# VITE_STORAGE_BUCKET=smi-files
# A dónde reenvía `vite preview` /api y el storage firmado (defaults abajo):
# VITE_PREVIEW_API_TARGET=http://localhost:3003
# VITE_PREVIEW_STORAGE_TARGET=http://localhost:9000
# Hosts que acepta `vite preview`, separados por coma (default abajo):
# VITE_PREVIEW_ALLOWED_HOSTS=.trycloudflare.com
